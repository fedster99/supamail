# Optional API app. Keep the always-on worker separate for the lowest bill.
# Copy to fly.api.toml and deploy with:
#   fly launch --config fly.api.toml --no-deploy
#   fly secrets set --config fly.api.toml DATABASE_URL=... IMAP_ENCRYPTION_KEY=... API_TOKEN=...
#   fly deploy --config fly.api.toml

app = "supamail-api"
primary_region = "iad"
kill_signal = "SIGINT"
kill_timeout = "30s"

[build]
  dockerfile = "Dockerfile"

[env]
  BODY_FETCH_POLICY = "priority_then_backfill"
  PORT = "3000"

[processes]
  api = "node dist/api.js"

[http_service]
  processes = ["api"]
  internal_port = 3000
  force_https = true
  auto_stop_machines = false
  auto_start_machines = true
  min_machines_running = 1

[[vm]]
  processes = ["api"]
  size = "shared-cpu-1x"
  memory = "512mb"
