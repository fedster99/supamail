# Copy to fly.toml and replace app/region before deploying:
#   cp fly.worker.toml.example fly.toml
#   fly launch --no-deploy --no-public-ips
#   fly secrets set DATABASE_URL=... IMAP_ENCRYPTION_KEY=...
#   fly deploy

app = "supamail-worker"
primary_region = "ord"
kill_signal = "SIGINT"
kill_timeout = "30s"

[build]
  dockerfile = "Dockerfile"

[env]
  NODE_OPTIONS = "--max-old-space-size=160"
  BODY_FETCH_POLICY = "priority_then_backfill"
  SYNC_INTERVAL_MS = "60000"
  WINDOW_DAYS = "90"
  BODY_RAW_MAX_BYTES = "8388608"
  BODY_BACKFILL_BATCH_SIZE = "3"
  INITIAL_SYNC_BATCH_SIZE = "25"
  INCREMENTAL_SYNC_BATCH_SIZE = "25"
  IMAP_MAX_COMMANDS_PER_MINUTE = "120"

[processes]
  worker = "node dist/worker.js"

[[vm]]
  processes = ["worker"]
  size = "shared-cpu-1x"
  memory = "256mb"
