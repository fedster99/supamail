diff --git a/lib/commands/notify.js b/lib/commands/notify.js
new file mode 100644
index 0000000000000000000000000000000000000000..3405b0ae2bd05954e614d94b4b3081ad8870dd63
--- /dev/null
+++ b/lib/commands/notify.js
@@ -0,0 +1,87 @@
+'use strict';
+
+const { decodePath, encodePath, hasCapability, normalizePath } = require('../tools.js');
+
+const MESSAGE_EVENTS = ['MessageNew', 'MessageExpunge', 'FlagChange'];
+
+function parseStatus(connection, untagged) {
+    let path = normalizePath(connection, decodePath(connection, (untagged.attributes[0] && untagged.attributes[0].value) || ''));
+    let list = untagged.attributes && Array.isArray(untagged.attributes[1]) ? untagged.attributes[1] : false;
+    if (!path || !list) {
+        return false;
+    }
+
+    const fields = {
+        MESSAGES: { key: 'messages', parser: Number },
+        RECENT: { key: 'recent', parser: Number },
+        UIDNEXT: { key: 'uidNext', parser: Number },
+        UIDVALIDITY: { key: 'uidValidity', parser: BigInt },
+        UNSEEN: { key: 'unseen', parser: Number },
+        HIGHESTMODSEQ: { key: 'highestModseq', parser: BigInt },
+        SIZE: { key: 'size', parser: Number },
+        DELETED: { key: 'deleted', parser: Number }
+    };
+    let key;
+    let status = { path };
+    for (let i = 0; i < list.length; i++) {
+        let entry = list[i];
+        if (i % 2 === 0) {
+            key = entry && typeof entry.value === 'string' ? entry.value.toUpperCase() : false;
+            continue;
+        }
+        let field = key && fields[key];
+        if (!field || !entry || typeof entry.value !== 'string' || isNaN(entry.value)) {
+            continue;
+        }
+        status[field.key] = field.parser(entry.value);
+    }
+    return status;
+}
+
+async function notify(connection, mailboxes) {
+    if (![connection.states.AUTHENTICATED, connection.states.SELECTED].includes(connection.state)
+        || !hasCapability(connection, 'NOTIFY')) {
+        return false;
+    }
+
+    mailboxes = [...new Set((mailboxes || []).map(path => normalizePath(connection, path)))]
+        .filter(path => path && path.toUpperCase() !== 'INBOX');
+    let events = MESSAGE_EVENTS.map(value => ({ type: 'ATOM', value }));
+    let attributes = [
+        { type: 'ATOM', value: 'SET' },
+        { type: 'ATOM', value: 'STATUS' },
+        [
+            { type: 'ATOM', value: 'SELECTED' },
+            events
+        ]
+    ];
+
+    if (mailboxes.length) {
+        let encoded = mailboxes.map(path => {
+            let value = encodePath(connection, path);
+            return { type: value.indexOf('&') >= 0 ? 'STRING' : 'ATOM', value };
+        });
+        attributes.push([
+            { type: 'ATOM', value: 'MAILBOXES' },
+            encoded.length === 1 ? encoded[0] : encoded,
+            events
+        ]);
+    }
+
+    let statuses = new Map();
+    let response = await connection.exec('NOTIFY', attributes, {
+        untagged: {
+            STATUS: async untagged => {
+                let status = parseStatus(connection, untagged);
+                if (status) {
+                    statuses.set(status.path, status);
+                }
+            }
+        }
+    });
+    response.next();
+    return [...statuses.values()];
+}
+
+module.exports = notify;
+module.exports.parseStatus = parseStatus;
