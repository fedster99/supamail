DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
IMAP_ENCRYPTION_KEY=replace-with-a-long-random-secret
API_TOKEN=replace-with-a-long-random-api-token
ADMIN_TOKEN=replace-with-a-different-long-random-token-for-migrations
# Set to "true" only when adding self-hosted IMAP servers on a private network
IMAP_ALLOW_PRIVATE_HOSTS=false
PORT=3000
SYNC_INTERVAL_MS=60000
WINDOW_DAYS=90
BODY_FETCH_POLICY=priority_then_backfill
BODY_RAW_MAX_BYTES=26214400
BODY_BACKFILL_BATCH_SIZE=25
MAX_BODY_BATCHES_PER_TICK=4
INITIAL_SYNC_BATCH_SIZE=50
INCREMENTAL_SYNC_BATCH_SIZE=50
INCREMENTAL_TOTAL_TIMEOUT_MS=300000
FOLDER_DISCOVERY_INTERVAL_MS=900000
FLAG_DIFF_WINDOW_DAYS=7
FLAG_SCAN_INTERVAL_MS=600000
PRIORITY_FLAG_SCAN_INTERVAL_MS=120000
RR_FLAG_SCAN_INTERVAL_MS=21600000
MAX_FLAG_SCANS_PER_CYCLE=2
FLAG_SCAN_TOTAL_TIMEOUT_MS=120000
RECONCILE_INTERVAL_MS=21600000
MAX_RECONCILES_PER_CYCLE=1
RECONCILE_TOTAL_TIMEOUT_MS=300000
CONNECT_TIMEOUT_MS=30000
IMAP_COMMAND_TIMEOUT_MS=60000
IMAP_MAX_COMMANDS_PER_MINUTE=200
MAX_LOCK_HOLD_MS=600000
STALE_HEARTBEAT_MS=300000
MAX_UIDVALIDITY_RESETS_24H=2
FOLDER_MISSING_GRACE_MS=604800000
PRIORITY_CUTOFF=10
MAX_PRIORITY_FOLDERS_PER_CYCLE=10
MAX_RR_FOLDERS_PER_CYCLE=5
SYNC_MAX_ACCOUNTS=20
PRIORITY_LAG_HEALTHY_THRESHOLD_MS=120000
OVERALL_LAG_HEALTHY_THRESHOLD_MS=900000
PRIORITY_RECONCILE_HEALTHY_MAX_AGE_MS=86400000
OVERALL_RECONCILE_HEALTHY_MAX_AGE_MS=604800000
EXPIRE_AFTER_DAYS=180
