{
  "name": "@supamail/api",
  "version": "0.1.0",
  "description": "Supabase/Postgres-native IMAP mirror with metadata, flags, attachments, sync health, and full message bodies.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "supamail": "dist/cli.js",
    "supamail-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist",
    "supabase/migrations/public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "dev:api": "tsx watch --clear-screen=false src/api.ts",
    "dry-run:local": "tsx scripts/local-dry-run.ts",
    "spec-conformance": "tsx scripts/spec-conformance.ts",
    "eval:search": "tsx scripts/eval-search.ts",
    "smoke:load": "tsx src/smoke/load-smoke.ts",
    "smoke:greenmail": "tsx scripts/greenmail-smoke.ts",
    "smoke:dovecot": "tsx scripts/dovecot-smoke.ts",
    "start:worker": "node dist/worker.js",
    "start:api": "node dist/api.js",
    "start:combined": "SUPAMAIL_MODE=combined node dist/runtime.js",
    "start:runtime": "node dist/runtime.js",
    "start:mcp": "node dist/mcp/server.js",
    "dev:mcp": "tsx watch src/mcp/server.ts",
    "migrate": "tsx src/cli.ts migrate",
    "test": "vitest run",
    "test:db:live": "tsx scripts/test-db-live.ts",
    "test:migration:threading-upgrade": "tsx scripts/test-threading-migration-upgrade.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "hono": "^4.12.32",
    "imapflow": "^1.6.1",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": "24.x"
  }
}
